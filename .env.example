# --- BirdNET-Go ---------------------------------------------------------
# Where the digest reads from (the Pi itself, via host networking)
BIRDNET_URL=http://localhost:8080
# Where links in the email should open, from your phone or laptop
BIRDNET_PUBLIC_URL=http://birdnet.local:8080
# Only needed if Private Mode is on and you haven't allowed a subnet bypass
BIRDNET_TOKEN=

STATION_NAME=Back garden
# Match the colour scheme you picked in BirdNET-Go: blue, forest, amber, violet, rose
COLOR_SCHEME=blue
# Ignore detections below this confidence (0 keeps everything BirdNET-Go stored)
MIN_CONFIDENCE=0

# --- Mailgun ------------------------------------------------------------
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.example.com
# us or eu, matching where the Mailgun domain was created
MAILGUN_REGION=us
MAIL_FROM=BirdNET-Go <birds@mg.example.com>
# Comma-separated
MAIL_TO=you@example.com

# --- Schedule -----------------------------------------------------------
# Reports the seven days up to and including yesterday
SCHEDULE_DAY=mon
SCHEDULE_TIME=07:30
TZ=America/St_Johns
